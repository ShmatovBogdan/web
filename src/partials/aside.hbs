<aside class="aside">
    <h2 class="aside__title">{{asideTitle}}</h2>
    <ul class="aside__list">
        {{#each asideLinks}}
            <li>
                <a class="aside__link" href="{{url}}" target="_blank" rel="noopener noreferrer">{{text}}</a>
            </li>
        {{/each}}
    </ul>
</aside>
