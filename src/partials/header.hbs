<header class="header flex flex-wrap items-center justify-between gap-4 bg-header px-6 py-4 text-header-text">
    <h1 class="header__title m-0 text-xl font-bold">
        {{labName}}
    </h1>

    <div class="header__actions flex items-center gap-5">
        <nav class="navigation" aria-label="Головна навігація">
            <ul class="navigation__list flex flex-wrap items-center gap-5">
                <li class="navigation__item">
                    <a href="/index.html"
                       class="navigation__link transition hover:opacity-70"
                       {{#if isHome}}aria-current="page"{{/if}}>
                        Головна
                    </a>
                </li>

                <li class="navigation__item">
                    <a href="/about.html"
                       class="navigation__link transition hover:opacity-70"
                       {{#if isAbout}}aria-current="page"{{/if}}>
                        Про нас
                    </a>
                </li>

                <li class="navigation__item">
                    <a href="/contacts.html"
                       class="navigation__link transition hover:opacity-70"
                       {{#if isContacts}}aria-current="page"{{/if}}>
                        Контакти
                    </a>
                </li>
            </ul>
        </nav>

        <button
            id="theme-toggle"
            type="button"
            class="theme-toggle flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-border transition hover:bg-table-heading"
            aria-label="Змінити тему"
            title="Змінити тему"
        >
            <img
                src="/src/assets/images/sun.png"
                alt=""
                class="h-6 w-6 dark:hidden"
            >

            <img
                src="/src/assets/images/moon.png"
                alt=""
                class="hidden h-6 w-6 dark:block"
            >
        </button>
    </div>
</header>