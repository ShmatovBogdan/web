<!DOCTYPE html>
<html lang="uk">
<head>
    {{> head}}
</head>

<body class="min-h-screen flex flex-col bg-background text-text transition-colors duration-200" data-page="{{pageCode}}">
    <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:p-3 focus:bg-surface focus:text-text focus:rounded-lg"
    >
        Перейти до основного контенту
    </a>

    {{> header}}

    <div class="flex-1 w-full max-w-7xl mx-auto p-6 flex flex-col lg:flex-row gap-6">

        {{> (lookup . "contentPartial")}}

        {{#if asideLinks}}
            {{> aside}}
        {{/if}}

    </div>

    {{> footer}}

    <script type="module" src="/src/main.js"></script>
</body>
</html>